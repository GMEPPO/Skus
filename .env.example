NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SKIP_AUTH=true
# Fase 2B.2 R5 — keep false until post-APPLY Blocks 4–7 pass + separate activation OK
NEXT_PUBLIC_SKUS_SECURE_GENERATION_V2=false
# Normalization UI V2 — independent gate (claim/complete RPCs)
NEXT_PUBLIC_SKUS_NORMALIZATION_V2=false
# Assistente nomenclatura (OpenAI) — server gate + UI
SKUS_AI_ASSISTANT_ENABLED=false
NEXT_PUBLIC_SKUS_AI_ASSISTANT=false
OPENAI_API_KEY=
# Opcional: URL base custom (proxy ChatGPT / Azure OpenAI)
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
